# ==============================================================================
# OilTrace Attribution System - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT.
# ==============================================================================

# Application Environment (development, production, test)
# Set to 'production' on Railway.
APP_ENV=development
APP_NAME=OilTrace Attribution Backend
DEBUG=true

# Operational Mode
# Set to false for live production.
DEMO_MODE=false

# ==============================================================================
# Database Configuration
# ==============================================================================
# LOCAL DEVELOPMENT:
# Uses persistent local SQLite database:
DATABASE_URL=sqlite:///data/oiltrace.db

# RAILWAY PRODUCTION:
# Reference the Railway Managed PostgreSQL service variable:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Normalized automatically from postgres:// or postgresql:// to postgresql+psycopg://

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Redis & Celery Background Queue
# Local: redis://localhost:6379/0
# Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Domain Data Directories (Absolute or relative to project root)
DATA_DIR=data
AIS_DATA_DIR=data/ais
OCEAN_DATA_DIR=data/sample
SATELLITE_DATA_DIR=data/satellite

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security (Required in production - generate with `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ALLOW_TECH_ADMIN_CREATION=false

# Transactional Email (Invitations & Password Reset)
# If unconfigured, invitation and reset links are printed to backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@oiltrace.gov
SMTP_FROM_NAME="OILTRACE Authority"
FRONTEND_BASE_URL=http://localhost:5173
DEV_EMAIL_LOG=true

# External Service Keys
VITE_MAPTILER_KEY=
GFW_API_TOKEN=
M1_API_URL=http://127.0.0.1:8001
M1_API_KEY=