# ==============================================================================
# OilTrace Attribution System - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT.
# ==============================================================================

# Application Environment (development, production, test)
APP_ENV=development
APP_NAME=OilTrace Attribution Backend
DEBUG=true

# Operational Mode
# When DEMO_MODE=true, backend serves authoritative demonstration artifacts
# when external services or database are offline. Set to false for live production.
DEMO_MODE=true

# Database Configuration (PostgreSQL + PostGIS)
# Example: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/oiltrace
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Redis & Celery Background Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Domain Data Directories (Absolute or relative to project root)
DATA_DIR=data
AIS_DATA_DIR=data/ais
OCEAN_DATA_DIR=data/sample
SATELLITE_DATA_DIR=data/satellite

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# External Map / Satellite Keys (Optional for production frontend)
# VITE_MAPTILER_KEY=your_maptiler_api_key_here

# ==============================================================================
# M1 Inference API Configuration
# ==============================================================================
M1_API_URL=http://127.0.0.1:8001
M1_API_KEY=your_m1_api_key_here
M1_MODEL_PATH=D:\sih_26_info\unet_best.pth